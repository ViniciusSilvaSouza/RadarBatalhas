# Exclude build outputs and VCS metadata
**/bin/
**/obj/
**/.vs/
**/.vscode/
**/.idea/
**/.git/
**/.gitignore
**/node_modules/

# Exclude local settings
**/appsettings.Local*.json
**/secrets.json

# Exclude environment files (do not send secrets to Docker context)
.env
.env.*
!.env.example

# Exclude test results and artifacts
**/TestResults/
**/coverage/

# Exclude Docker artifacts for cleaner context
Dockerfile*
**/*.md
**/docker-compose.*.override.yml
